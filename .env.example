# Copy to .env and fill in.

# PostgreSQL connection string.
# Local: run Postgres and point here.
# Railway: add a PostgreSQL database, then set this service variable to
#   ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign session cookies (JWT). Use a long random string.
AUTH_SECRET="please-change-me-to-a-long-random-secret"

# First Owner account, created on first boot when the DB has no users.
# Defaults to admin@uzlider.com / admin123 if omitted (change after login).
ADMIN_EMAIL="you@company.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Administrator"

# Telegram webhook secret (optional but recommended). Set this AND pass the same
# value as secret_token when registering the webhook, so only Telegram can call
# /api/telegram/webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<DOMAIN>/api/telegram/webhook&secret_token=<SECRET>"
# The bot token and dispatch chat id are configured in the app (Settings page).
TELEGRAM_WEBHOOK_SECRET="a-long-random-webhook-secret"

# Set to "true" ONCE to wipe ALL data before seeding (clears old demo records),
# then remove it. Leave unset/false in normal operation.
# RESET_DEMO="true"
