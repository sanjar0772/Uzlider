generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Roles & statuses as first-class enums ----

enum Role {
  OWNER // Rahbar — full access
  MANAGER // Menejer — full access
  DISPATCHER // Dispetcher — create/assign loads, manage drivers & trucks
  UPDATER // Yangilovchi — post status updates
  ACCOUNTANT // Buxgalter — billing, invoices, reports
  DRIVER // Haydovchi — sees only own loads
}

enum LoadStatus {
  NEW
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_LOAD
  OFF_DUTY
}

enum TruckStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum EquipmentType {
  VAN
  REEFER
  FLATBED
  POWER_ONLY
  STEP_DECK
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(DISPATCHER)
  phone        String?
  driverId     String?  @unique
  driver       Driver?  @relation(fields: [driverId], references: [id])
  // Telegram account linking
  telegramChatId   String? @unique
  telegramUsername String?
  telegramLinkCode String? @unique
  createdAt    DateTime @default(now())
}

model Driver {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  email         String?
  truckNumber   String?
  trailerNumber String?
  licenseNumber String?
  status        DriverStatus @default(AVAILABLE)
  notes         String?
  // Compliance & HOS
  cdlExpiry      DateTime?
  medicalExpiry  DateTime?
  hireDate       DateTime?
  availableHours Float?    @default(70) // HOS cycle hours remaining (simplified)
  homeBase       String?
  createdAt     DateTime     @default(now())

  account User?
  loads   Load[]
  truck   Truck?
}

model Truck {
  id           String      @id @default(cuid())
  unitNumber   String      @unique
  plate        String?
  make         String?
  model        String?
  year         Int?
  vin          String?
  status       TruckStatus @default(ACTIVE)
  notes        String?
  // Fuel & compliance
  odometer            Int?
  mpg                 Float?
  registrationExpiry  DateTime?
  inspectionExpiry    DateTime?
  insuranceExpiry     DateTime?
  createdAt    DateTime    @default(now())

  driverId     String?     @unique
  driver       Driver?     @relation(fields: [driverId], references: [id])

  loads        Load[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  mcNumber  String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  loads Load[]
}

model Load {
  id             String        @id @default(cuid())
  refNumber      String        @unique
  broker         String?
  origin         String
  destination    String
  pickupDate     DateTime?
  deliveryDate   DateTime?
  rate           Float?
  driverPay      Float?
  miles          Int?
  deadheadMiles  Int?
  detention      Float?
  lumperFee      Float?
  otherCharges   Float?
  weight         Int?
  commodity      String?
  equipment      EquipmentType @default(VAN)
  status         LoadStatus    @default(NEW)
  notes          String?

  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])

  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id])

  truckId        String?
  truck          Truck?        @relation(fields: [truckId], references: [id])

  dispatcherId   String?
  dispatcherName String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  updates        LoadUpdate[]
  invoice        Invoice?
}

model LoadUpdate {
  id         String      @id @default(cuid())
  loadId     String
  load       Load        @relation(fields: [loadId], references: [id], onDelete: Cascade)
  status     LoadStatus?
  location   String?
  note       String?
  authorId   String?
  authorName String?
  createdAt  DateTime    @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  loadId      String        @unique
  load        Load          @relation(fields: [loadId], references: [id], onDelete: Cascade)
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  factored    Boolean       @default(false)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Company-wide cost assumptions used to compute per-load profit.
model CompanySettings {
  id                String   @id @default(cuid())
  companyName       String   @default("Uzlider Trucking")
  mpg               Float    @default(6.5)
  fuelPricePerGallon Float   @default(4.10)
  fixedCostPerMile  Float    @default(0.35)
  targetRpm         Float    @default(2.00)
  factoringRatePct  Float    @default(3.0)
  // ---- Telegram integration ----
  telegramEnabled   Boolean  @default(false)
  telegramBotToken  String?
  telegramChatId    String?  // dispatch group / channel id for broadcasts
  notifyNewLoad     Boolean  @default(true)
  notifyStatus      Boolean  @default(true)
  notifyInvoicePaid Boolean  @default(true)
  notifyCompliance  Boolean  @default(true)
  updatedAt         DateTime @updatedAt @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String // e.g. "created", "updated", "deleted", "status_changed"
  entity    String // e.g. "load", "driver", "invoice"
  entityRef String? // human-readable ref (e.g. LD-1001)
  detail    String?
  createdAt DateTime @default(now())
}
